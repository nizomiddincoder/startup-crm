# Bu faylni nusxa qilib `.env` deb nomlang va qiymatlarni to'ldiring.
# .env hech qachon git'ga yuklanmaydi. (npm run local birinchi marta o'zi yaratadi)

# Lokal baza (npm run db:local yoki docker-compose.yml bilan mos)
DATABASE_URL="postgresql://kassa:kassa@localhost:5432/kassa?schema=public"

# Auth.js — maxfiy kalit. Yaratish: npx auth secret. (AUTH_URL kerak emas — domen avtomatik aniqlanadi)
AUTH_SECRET="bu-yerga-uzun-tasodifiy-satr"

# Serverda birinchi platforma adminini yaratish (faqat birinchi ishga tushishda, DEPLOY.md).
# Lokal ishlab chiqishda kerak emas — demo seed'da admin bor.
# ADMIN_LOGIN="admin"
# ADMIN_PASSWORD=""
# ADMIN_NAME="Platforma admini"

# Telegram bot (P6). @BotFather'da bot yarating: token va bot nomi (@ belgisiz)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
# Saytdan yangi ariza kelganda shu chat'ga xabar boradi (S2). Chat ID'ni bilish:
# Telegram'da @userinfobot'ga /start yozing. Botingizga ham bir marta /start yozing.
ADMIN_TELEGRAM_CHAT_ID=""
# Toshkent vaqti bo'yicha soat (0–23)
TELEGRAM_REPORT_HOUR="20"
TELEGRAM_REMINDER_HOUR="10"

# ===== Sotuv sayti (S4) — bo'sh qolsa, tegishli narsa saytda chiqmaydi =====
# Saytning asosiy manzili (Google, sitemap, Telegram havola rasmi uchun). Domen ulanganda:
# SITE_URL="https://kassa.uz"
SITE_URL=""
# "Telegramda yozish" tugmasi (pastki o'ng burchak). Masalan: https://t.me/kassa_yordam
TELEGRAM_CONTACT_URL=""
# Meta (Facebook/Instagram) Pixel ID — faqat raqamlar. Events Manager → Data sources → Pixel
META_PIXEL_ID=""
# Google Analytics 4 — "G-" bilan boshlanadigan Measurement ID
GA_MEASUREMENT_ID=""

# ===== Sun'iy intellekt (K3): mahsulot rasmlari — Google Gemini =====
# Kalit: https://aistudio.google.com/apikey (bo'sh — AI o'chiq, rasmni qo'lda yuklash ishlaydi)
GEMINI_API_KEY=""
# Rasm modeli (o'zgartirish shart emas)
GEMINI_IMAGE_MODEL="gemini-2.5-flash-image"
# Har do'konga kuniga AI rasm so'rovlari (xarajat nazorati; bitta rasm ≈ $0.04)
GEMINI_DAILY_LIMIT="30"
# AI yordamchi ("Yordam" oynasi) — matn modeli va do'konga kunlik savollar soni
GEMINI_TEXT_MODEL="gemini-2.5-flash"
ASSISTANT_DAILY_LIMIT="100"

# ===== Yangiliklar (K4) =====
# Telegram kanal: @kanal_nomi yoki -100... ID. Bot kanalga ADMIN qilib qo'shilishi kerak.
TELEGRAM_NEWS_CHANNEL=""
